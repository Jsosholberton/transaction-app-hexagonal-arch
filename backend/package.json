{
  "name": "nestjs-hexagonal-lambda-api-wompi",
  "version": "1.0.0",
  "description": "NestJS API with Hexagonal Architecture deployed on AWS Lambda for Wompi integration",
  "main": "dist/main.js",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:local": "ts-node src/main-local.ts --watch",
    "build": "nest build",
    "build:lambda": "tsc && cp -r src/seeds dist/seeds",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "seed": "ts-node src/seeds/seed-products.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.16",
    "@nestjs/core": "^11.0.16",
    "@nestjs/platform-express": "^11.0.16",
    "@vendia/serverless-express": "^4.12.6",
    "aws-lambda": "^1.0.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.0.16",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^18.17.0",
    "eslint": "^8.47.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
